# Copy this file to ".env" at the repo root and fill in your real Neon values
# (console.neon.tech > your project > Connection Details).
#
# JDBC URL format for Neon:
#   jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require

DB_URL=jdbc:postgresql://<your-host>.neon.tech/agence_user_db?sslmode=require
DB_USERNAME=<your-neon-user>
DB_PASSWORD=<your-neon-password>

# Secret used to sign JWTs — replace with a long random string in production.
JWT_SECRET=ChangeMeThisIsADevOnlySecretKeyPleaseReplaceInProd123456
JWT_EXPIRATION_MS=86400000

# Optional initial administrator (created/promoted when the service starts).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# SMTP credentials used to send the 6-digit e-mail verification code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Agence Travel
EMAIL_CODE_EXPIRATION_MINUTES=10

# Comma-separated list of frontend origins allowed to call the API with credentials.
# In production this must be your real domain(s), e.g. https://app.your-domain.com
FRONTEND_ORIGINS=http://localhost:4200,http://localhost:4000

# Auth endpoint rate limiting (per client IP, fixed window)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# "update" is fine for local dev; set to "validate" in production once you introduce
# a migration tool (Flyway/Liquibase) so deploys can't silently alter the live schema.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
APP_LOG_LEVEL=INFO
